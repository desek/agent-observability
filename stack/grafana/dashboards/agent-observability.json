    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_metrics}"
      },
      "description": "Total agent cost in United States dollars over the selected time range. The value sums the last sample of each cost series with last_over_time. The agent, repository, branch, and model variables filter this panel. This panel covers Claude Code and pi. If only one agent has run, the panel shows that agent only. Source metric family: cost_usage_USD.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No data. Run an agent session with telemetry on, then widen the time range.",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calc": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_metrics}"
          },
          "editorMode": "code",
          "expr": "sum(last_over_time({__name__=~\"claude_code_cost_usage_USD_total|pi_cost_usage_USD_total\", job=~\"$agent\", git_repo=~\"$git_repo\", git_branch=~\"$git_branch\", model=~\"${model:regex}\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A"
