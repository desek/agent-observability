# pi-otel.env: non-secret OpenTelemetry content and cardinality flags for pi.
#
# @agents-index: Non-secret OTEL_LOG_* and OTEL_METRICS_INCLUDE_* opt-in flags for the pi coding agent, sourced by a shell or by the direnvrc helper in this directory.
#
# Purpose: carry only the opt-in flags that have no safe default. These are the
# content-logging flags and the metric-cardinality flags. The pi
# OpenTelemetry extension, published to npm as @desek/pi-opentelemetry, supplies
# every other value as a dynamic default:
#   - the OTLP endpoint and protocol default to the local HAProxy edge proxy on
#     EDGE_PORT, which defaults to 24317 (see compose.yaml);
#   - the master switch defaults to enabled. When neither the master switch nor
#     the endpoint is set, the extension gates itself on an Alloy health probe,
#     so a machine without the stack running exports nothing;
#   - git provenance is derived from the repository of the launch directory.
#
# This file deliberately does NOT set the master switch and does NOT set the
# endpoint. The extension's dynamic defaults govern both. Set them yourself only
# to override that behaviour.
#
# Usage: source this file to export its flags, then launch pi. The direnvrc
# helper in this directory does the same through `use pi_otel` and also stamps
# git provenance for Claude Code. To force export in a one-off shell instead:
#   set -a && . agents/pi-otel.env && set +a
#   pi -p "say hi"
#
# This file carries no secret. Any credential value lives only in the gitignored
# .env file, never here.

# Client export cadence: ship each signal at most 1s after it is produced, for a
# responsive local feedback loop. These feed the extension's per-signal metric
# reader interval and the batch log and span processor delay. pi also
# force-flushes on agent end, so one-shot `pi -p` runs ship immediately. These
# intervals govern long interactive sessions.
OTEL_METRIC_EXPORT_INTERVAL=1000
OTEL_LOGS_EXPORT_INTERVAL=1000
OTEL_TRACES_EXPORT_INTERVAL=1000

# Content-logging opt-in flags. Each flag is off by default in the extension
# when it is unset. This file turns them all on, so the deployed posture records
# prompts, responses, tool details, tool content, and raw API bodies. The
# pipeline binds to localhost only. Unset any flag to redact that field.
OTEL_LOG_USER_PROMPTS=1
OTEL_LOG_ASSISTANT_RESPONSES=1
OTEL_LOG_TOOL_DETAILS=1
OTEL_LOG_TOOL_CONTENT=1
OTEL_LOG_RAW_API_BODIES=1

# Metric-attribute cardinality opt-in flags. Each flag is off by default in the
# extension when it is unset. This file turns them on, so the promoted resource
# attributes (git provenance) ride on pi metric series for parity with Claude
# Code.
OTEL_METRICS_INCLUDE_RESOURCE_ATTRIBUTES=1
OTEL_METRICS_INCLUDE_VERSION=1
OTEL_METRICS_INCLUDE_ENTRYPOINT=1
