# Purpose: template for the local .env file. Copy this file to .env and set the
# values you need. This file holds variable names and safe defaults only. It
# carries no real credential and is safe to commit. The real .env is ignored by
# git.
# @agents-index: Committed template that documents every supported environment variable with its default.
#
# Usage:
#   cp .env.example .env
#   Edit .env to change a value. The stack starts with no .env at all, because
#   every variable below has a working default.

# EDGE_PORT: the single loopback host port that the edge proxy publishes.
# The whole stack is reachable through this one port on 127.0.0.1. Change this
# value if another program on your machine already uses the default.
# Default: 24317
EDGE_PORT=24317

# NPM_TOKEN: auth token used only when you publish the companion npm package.
# The stack itself does not need it. Leave it empty for normal use. Set a real
# token here only on a machine that publishes the package, and never commit the
# real value.
# Default: empty
NPM_TOKEN=
