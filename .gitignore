# Purpose: keep secrets, local data, and build output out of version control.
# This file lists paths git must never track. It protects the loopback-only
# privacy posture of the stack: local data volumes and any credential file
# stay on the machine.
# @agents-index: Git ignore rules that keep secrets, local data, and build output untracked.

# Secrets and local environment.
# .env holds credentials, for example an npm publish token. It must never be
# committed. .env.example is the committed, non-secret template and is exempt.
.env
.env.*
!.env.example

# Node dependencies and build output.
node_modules/
dist/
*.tgz

# Local data and logs produced by running the stack or the scripts.
*.log

# Operating system and editor noise.
.DS_Store

# Local npm auth pointer. Holds a variable name, never a value.
.npmrc

# Backup files (may hold copied credentials)
.npmrc.bak
*.bak
